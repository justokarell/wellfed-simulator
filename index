<!DOCTYPE html> 
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>WellFed · Tax Savings Simulator</title>
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet"/>
<style>
*{box-sizing:border-box;margin:0;padding:0}
:root{
  --off:#F7F5F0;
  --ink:#1A1A18;
  --forest:#1E3D2F;
  --gold:#C8A84B;
  --gold-l:#E8D08B;
  --muted:#6B6B63;
  --border:#E0DDD6;
  --white:#FFFFFF;
  --green-bg:#EFF9F2;
  --green-border:#86EFAC;
  --green-text:#166534;
  --red-bg:#FEF2F2;
  --red-border:#FCA5A5;
  --red-text:#991B1B;
}
html{scroll-behavior:smooth}
body{font-family:'Inter',sans-serif;background:var(--off);color:var(--ink);font-size:15px;line-height:1.6;min-height:100vh}

/* NAV */
nav{display:flex;align-items:center;justify-content:space-between;padding:16px 40px;border-bottom:1px solid var(--border);background:var(--off);position:sticky;top:0;z-index:100}
.logo{font-family:'Barlow Condensed',sans-serif;font-size:22px;font-weight:700;color:var(--ink)}
.logo span{color:var(--gold)}
.nav-tag{font-size:12px;color:var(--muted);margin-left:10px}

/* HERO */
.hero{text-align:center;padding:64px 40px 48px;max-width:820px;margin:0 auto}
.eyebrow{font-size:11px;font-weight:600;letter-spacing:2px;text-transform:uppercase;color:var(--muted);margin-bottom:20px}
.hero-num{font-family:'Barlow Condensed',sans-serif;font-size:clamp(64px,12vw,112px);font-weight:700;line-height:1;color:var(--gold);letter-spacing:-2px;margin-bottom:6px}
.hero-numsub{font-size:13px;color:var(--muted);margin-bottom:28px}
.hero-h1{font-family:'Barlow Condensed',sans-serif;font-size:clamp(28px,5vw,44px);font-weight:600;line-height:1.1;margin-bottom:14px}
.hero-body{font-size:15px;color:var(--muted);max-width:480px;margin:0 auto 8px}

/* DIVIDER */
hr{border:none;border-top:1px solid var(--border);margin:0 40px}

/* SIMULATOR */
.sim-wrap{background:var(--forest);padding:56px 40px}
.sim-inner{max-width:860px;margin:0 auto}
.sim-label{font-size:11px;font-weight:600;letter-spacing:2px;text-transform:uppercase;color:#8FAB87;margin-bottom:6px}
.sim-h2{font-family:'Barlow Condensed',sans-serif;font-size:32px;font-weight:700;color:#E8F0E4;margin-bottom:28px}
.sim-box{background:var(--off);border-radius:12px;padding:28px}

/* FORM GRID */
.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:20px}
.field label{font-size:12px;font-weight:500;color:var(--muted);display:block;margin-bottom:5px}
select{width:100%;font-size:13px;padding:8px 10px;border-radius:7px;border:1px solid var(--border);background:var(--white);color:var(--ink);font-family:'Inter',sans-serif;cursor:pointer}
select:focus{outline:2px solid var(--gold);outline-offset:1px}
.sl-row{display:flex;justify-content:space-between;align-items:center;margin-bottom:4px}
.sl-val{font-size:13px;font-weight:600;color:var(--gold)}
input[type=range]{width:100%;accent-color:var(--gold);cursor:pointer}
.dist-tag{display:inline-block;font-size:11px;background:#EFF9F2;color:#166534;padding:2px 8px;border-radius:4px;margin-top:5px;font-weight:500}
.rb-row{display:flex;gap:8px;margin-top:4px}
.rb{flex:1;padding:8px 0;text-align:center;border-radius:7px;font-size:12px;font-weight:600;cursor:pointer;border:1px solid var(--border);background:var(--white);color:var(--muted);transition:all .15s;user-select:none}
.rb.on{border-color:var(--gold);background:#FBF5E6;color:#7A5F1A}

/* RESULT */
.result{margin-top:20px}
.empty{text-align:center;padding:36px;color:var(--muted);font-size:13px;background:var(--white);border-radius:10px;border:1px solid var(--border)}
.verdict{display:flex;align-items:center;gap:12px;padding:14px 16px;border-radius:9px;margin-bottom:16px}
.v-ok{background:var(--green-bg);border:1px solid var(--green-border)}
.v-no{background:var(--red-bg);border:1px solid var(--red-border)}
.v-icon{font-size:22px;flex-shrink:0}
.v-title{font-size:14px;font-weight:600}
.v-ok .v-title{color:var(--green-text)}
.v-no .v-title{color:var(--red-text)}
.v-sub{font-size:11px;color:var(--muted);margin-top:2px}
.v-bracket{margin-left:auto;text-align:right;flex-shrink:0}
.v-bracket-label{font-size:10px;color:var(--muted)}
.v-bracket-val{font-family:'Barlow Condensed',sans-serif;font-size:24px;font-weight:700;color:var(--gold)}

.metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:16px}
.mc{background:var(--white);border:1px solid var(--border);border-radius:8px;padding:12px 14px}
.ml{font-size:10px;color:var(--muted);margin-bottom:4px;font-weight:500}
.mv{font-size:19px;font-weight:700}
.mv-ok{color:var(--green-text)}
.mv-no{color:var(--red-text)}
.mv-neu{color:var(--ink)}

.ann-banner{background:#FBF5E6;border:1px solid #E8C97A;border-radius:8px;padding:14px 18px;display:flex;align-items:center;gap:14px;margin-bottom:0}
.ann-icon{font-size:22px}
.ann-text{font-size:13px;color:#5C4A10}
.ann-val{font-family:'Barlow Condensed',sans-serif;font-size:26px;font-weight:700;color:var(--gold);margin-left:auto}

/* STATS */
.stats-wrap{padding:56px 40px;max-width:860px;margin:0 auto}
.stats-label{font-size:11px;font-weight:600;letter-spacing:2px;text-transform:uppercase;color:var(--muted);margin-bottom:32px}
.stats-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
.stat-card{background:var(--white);border:1px solid var(--border);border-radius:10px;padding:22px}
.stat-num{font-family:'Barlow Condensed',sans-serif;font-size:38px;font-weight:700;color:var(--gold);margin-bottom:6px}
.stat-title{font-size:13px;font-weight:600;color:var(--ink);margin-bottom:5px}
.stat-body{font-size:12px;color:var(--muted);line-height:1.6}

/* CTA */
.cta-wrap{background:var(--forest);padding:64px 40px;text-align:center}
.cta-inner{max-width:520px;margin:0 auto}
.cta-h2{font-family:'Barlow Condensed',sans-serif;font-size:38px;font-weight:700;color:#E8F0E4;line-height:1.1;margin-bottom:12px}
.cta-body{font-size:14px;color:#8FAB87;margin-bottom:28px}
.cta-price{font-family:'Barlow Condensed',sans-serif;font-size:26px;font-weight:600;color:var(--gold);margin-bottom:16px}
.cta-btn{display:inline-block;background:var(--gold);color:var(--ink);font-family:'Inter',sans-serif;font-size:14px;font-weight:600;padding:13px 36px;border-radius:8px;border:none;cursor:pointer;transition:background .15s;text-decoration:none}
.cta-btn:hover{background:var(--gold-l)}
.cta-note{font-size:11px;color:#8FAB87;margin-top:10px}

/* FOOTER */
footer{border-top:1px solid var(--border);padding:20px 40px;display:flex;justify-content:space-between;align-items:center;background:var(--off)}
.f-logo{font-family:'Barlow Condensed',sans-serif;font-size:18px;font-weight:700}
.f-logo span{color:var(--gold)}
.f-note{font-size:11px;color:var(--muted);max-width:520px;text-align:right}

@media(max-width:640px){
  nav{padding:14px 20px}
  .nav-tag{display:none}
  .hero{padding:40px 20px 32px}
  hr{margin:0 20px}
  .sim-wrap{padding:40px 20px}
  .form-grid{grid-template-columns:1fr}
  .metrics{grid-template-columns:1fr 1fr}
  .stats-wrap{padding:40px 20px}
  .stats-grid{grid-template-columns:1fr}
  .cta-wrap{padding:48px 20px}
  footer{padding:16px 20px;flex-direction:column;gap:8px;text-align:center}
  .f-note{text-align:center}
}
</style>
</head>
<body>

<nav>
  <div>
    <span class="logo">Well<span>Fed</span></span>
    <span class="nav-tag">Tax Savings Simulator</span>
  </div>
</nav>

<section class="hero">
  <div class="eyebrow">PATH Act Enhanced Food Donation Deduction · Upper West Side, NYC</div>
  <div class="hero-num" id="heroNum">$0</div>
  <div class="hero-numsub">estimated annual tax savings for a full-service restaurant donating surplus meals five nights a week</div>
  <div class="hero-h1">You're throwing away money with the food.</div>
  <div class="hero-body">The IRS lets you deduct significantly more than cost basis when you donate surplus food to a qualified nonprofit. Most restaurants have never claimed it.</div>
</section>

<hr/>

<section class="sim-wrap">
  <div class="sim-inner">
    <div class="sim-label">Savings calculator</div>
    <div class="sim-h2">What would you save?</div>
    <div class="sim-box">

      <div class="form-grid">
        <div class="field">
          <label>Your business</label>
          <select id="dSel"></select>
          <div id="dInfo" style="font-size:11px;color:var(--muted);margin-top:5px"></div>
        </div>
        <div class="field">
          <label>Nonprofit recipient</label>
          <select id="nSel"><option value="">— select a nonprofit —</option></select>
          <div id="distTag"></div>
        </div>
      </div>

      <div class="form-grid">
        <div class="field">
          <div class="sl-row">
            <label>Annual taxable income</label>
            <span class="sl-val" id="iVal">$120,000</span>
          </div>
          <input type="range" id="income" min="10000" max="700000" step="5000" value="120000"
            oninput="sl(this,'iVal',v=>`$${Math.round(v).toLocaleString()}`)">
        </div>
        <div class="field">
          <label>Who makes the delivery?</label>
          <div class="rb-row">
            <div class="rb on" id="rbS" onclick="setT('self')">I deliver</div>
            <div class="rb" id="rbD" onclick="setT('driver')">Hire a driver</div>
          </div>
          <div id="wageWrap" style="display:none;margin-top:10px">
            <div class="sl-row">
              <label>Driver wage</label>
              <span class="sl-val" id="wVal">$18/hr</span>
            </div>
            <input type="range" id="wage" min="10" max="40" step="0.5" value="18"
              oninput="sl(this,'wVal',v=>`$${parseFloat(v).toFixed(0)}/hr`)">
          </div>
        </div>
      </div>

      <details style="margin-bottom:16px">
        <summary style="font-size:12px;color:var(--muted);cursor:pointer;user-select:none">Advanced trip cost parameters</summary>
        <div class="form-grid" style="margin-top:14px;margin-bottom:0">
          <div class="field">
            <div class="sl-row"><label>Gas price</label><span class="sl-val" id="gVal">$3.80/gal</span></div>
            <input type="range" id="gas" min="2" max="8" step="0.1" value="3.8"
              oninput="sl(this,'gVal',v=>`$${parseFloat(v).toFixed(2)}/gal`)">
          </div>
          <div class="field">
            <div class="sl-row"><label>Vehicle MPG</label><span class="sl-val" id="mVal">25 mpg</span></div>
            <input type="range" id="mpg" min="10" max="60" step="1" value="25"
              oninput="sl(this,'mVal',v=>`${v} mpg`)">
          </div>
          <div class="field">
            <div class="sl-row"><label>Avg speed (mph)</label><span class="sl-val" id="sVal">15 mph</span></div>
            <input type="range" id="spd" min="5" max="40" step="1" value="15"
              oninput="sl(this,'sVal',v=>`${v} mph`)">
          </div>
          <div class="field">
            <div class="sl-row"><label>Container cost</label><span class="sl-val" id="cVal">$5.00</span></div>
            <input type="range" id="cont" min="0" max="20" step="0.5" value="5"
              oninput="sl(this,'cVal',v=>`$${parseFloat(v).toFixed(2)}`)">
          </div>
        </div>
      </details>

      <div id="result">
        <div class="empty">Select a nonprofit above to see your estimated tax savings.</div>
      </div>

    </div>
  </div>
</section>

<section class="stats-wrap">
  <div class="stats-label">By the numbers · Upper West Side simulation</div>
  <div class="stats-grid">
    <div class="stat-card">
      <div class="stat-num">85%</div>
      <div class="stat-title">of UWS food businesses are viable donors</div>
      <div class="stat-body">159 of 187 businesses in a 1,200-meter radius clear the economic viability threshold under current PATH Act parameters.</div>
    </div>
    <div class="stat-card">
      <div class="stat-num">$4,100</div>
      <div class="stat-title">average annual tax savings per business</div>
      <div class="stat-body">Across viable donors donating five days a week, 50 weeks a year. Prepared meal donors average $8,750 annually.</div>
    </div>
    <div class="stat-card">
      <div class="stat-num">0.76 mi</div>
      <div class="stat-title">average distance to nearest nonprofit</div>
      <div class="stat-body">Every viable UWS donor is within walking distance of a qualified recipient. Most trips take under 10 minutes.</div>
    </div>
  </div>
</section>

<section class="cta-wrap">
  <div class="cta-inner">
    <div class="cta-h2">Start capturing your deductions tonight.</div>
    <div class="cta-body">WellFed handles donation logging, nonprofit confirmation, and year-end tax documentation. You handle the food.</div>
    <div class="cta-price">$75 / month</div>
    <a class="cta-btn" href="mailto:hello@wellfed.io?subject=I want to sign up">Get started</a>
    <div class="cta-note">Cancel anytime · Nonprofits always free</div>
  </div>
</section>

<footer>
  <div class="f-logo">Well<span>Fed</span></div>
  <div class="f-note">Tax savings conditional on positive taxable income and donation to a qualified 501(c)(3) under the PATH Act of 2015. Distances are straight-line; actual routing distances are 20–40% longer in urban settings.</div>
</footer>

<script>
const NPS=[
  {id:"wscah",name:"West Side Campaign Against Hunger",lat:40.7889,lon:-73.9750},
  {id:"ncjw", name:"National Council of Jewish Women", lat:40.7754,lon:-73.9800},
  {id:"stmike",name:"St. Michael's Church",            lat:40.7804,lon:-73.9812},
  {id:"unitar",name:"Unitarian Church of All Souls",   lat:40.7733,lon:-73.9579},
  {id:"parkav",name:"Park Avenue Synagogue",           lat:40.7757,lon:-73.9583},
  {id:"stluke",name:"St. Luke's Food Pantry",          lat:40.7978,lon:-73.9680},
];
const DONORS=[
  {id:"gin",    name:"The Speakeasy at The Gin Mill",  lat:40.7868,lon:-73.9807,cat:"Prepared Meals",units:22},
  {id:"blonde", name:"Blondies Sports",                lat:40.7851,lon:-73.9793,cat:"Prepared Meals",units:20},
  {id:"buceo",  name:"Buceo 95",                       lat:40.7924,lon:-73.9742,cat:"Prepared Meals",units:18},
  {id:"gebhard",name:"Gebhard's Beer Culture",         lat:40.7907,lon:-73.9731,cat:"Beverages",     units:25},
  {id:"carlyle",name:"Café Carlyle",                   lat:40.7739,lon:-73.9632,cat:"Prepared Meals",units:19},
  {id:"gennaro",name:"Gennaro Restaurant",             lat:40.7877,lon:-73.9820,cat:"Prepared Meals",units:21},
  {id:"barney", name:"Barney Greengrass",              lat:40.7852,lon:-73.9798,cat:"Dairy",          units:14},
  {id:"belle",  name:"Hotel Belleclaire Kitchen",      lat:40.7861,lon:-73.9810,cat:"Prepared Meals",units:17},
  {id:"bellini",name:"Bellini",                        lat:40.7743,lon:-73.9820,cat:"Baked Goods",    units:30},
  {id:"sabar",  name:"Café Sabarsky",                  lat:40.7838,lon:-73.9589,cat:"Baked Goods",    units:28},
  {id:"vbar",   name:"V&T Restaurant",                 lat:40.8012,lon:-73.9660,cat:"Prepared Meals",units:16},
  {id:"amster", name:"Amsterdam Restaurant & Bar",     lat:40.7905,lon:-73.9760,cat:"Fresh Produce",  units:35},
  {id:"wave",   name:"Wave Hill Bread",                lat:40.7830,lon:-73.9820,cat:"Baked Goods",    units:40},
  {id:"joe",    name:"Joe Coffee UWS",                 lat:40.7843,lon:-73.9796,cat:"Beverages",      units:18},
  {id:"ouest",  name:"Ouest Restaurant",               lat:40.7880,lon:-73.9832,cat:"Prepared Meals",units:23},
];
const PR={
  "Prepared Meals":{a:2.50,s:.60,C:4.50},
  "Baked Goods":   {a:1.80,s:.50,C:1.80},
  "Fresh Produce": {a:.60, s:.40,C:1.20},
  "Dairy":         {a:.90, s:.30,C:2.00},
  "Beverages":     {a:3.50,s:.70,C:.80},
};
const BR=[[11600,.10],[47150,.12],[100525,.22],[191950,.24],[243725,.32],[609350,.35],[Infinity,.37]];

function mRate(v){for(const[c,r]of BR)if(v<=c)return r;return .37}
function npdf(x){return Math.exp(-.5*x*x)/Math.sqrt(2*Math.PI)}
function ncdf(x){const t=1/(1+.2316419*Math.abs(x));const p=t*(.31938+t*(-.35656+t*(1.78148+t*(-1.82126+t*1.33027))));return x>=0?1-npdf(x)*p:npdf(x)*p}
function edVal(a,C,sC){
  const s=Math.max(sC*C,1e-9),z=(2-a)*C/s,ph=npdf(z),Ph=ncdf(z);
  const Et=Ph>1e-10?a*C+s*ph/Ph:a*C;
  return Math.min((C+.5*Et)*Ph+2*C*(1-Ph),2*C);
}
function hav(a,b,c,d){
  const R=3958.8,dA=(c-a)*Math.PI/180,dO=(d-b)*Math.PI/180;
  const x=Math.sin(dA/2)**2+Math.cos(a*Math.PI/180)*Math.cos(c*Math.PI/180)*Math.sin(dO/2)**2;
  return R*2*Math.atan2(Math.sqrt(x),Math.sqrt(1-x));
}
function tripCost(dist,gas,mpg,wage,spd,cont){return dist*(gas/mpg+wage/spd)+cont}
function gv(id){return parseFloat(document.getElementById(id).value)}

let D=DONORS[0], N=null, transport='self';

function sl(el,vid,fmt){document.getElementById(vid).textContent=fmt(el.value);compute()}

function setT(t){
  transport=t;
  document.getElementById('rbS').className='rb'+(t==='self'?' on':'');
  document.getElementById('rbD').className='rb'+(t==='driver'?' on':'');
  document.getElementById('wageWrap').style.display=t==='driver'?'block':'none';
  compute();
}

function compute(){
  if(!N){
    document.getElementById('result').innerHTML='<div class="empty">Select a nonprofit above to see your estimated tax savings.</div>';
    return;
  }
  const p=PR[D.cat];
  const ed=edVal(p.a,p.C,p.s);
  const t=mRate(gv('income'));
  const n=D.units;
  const gas=gv('gas'),mpg=gv('mpg'),spd=gv('spd'),cont=gv('cont');
  const wage=transport==='driver'?gv('wage'):0;
  const dist=hav(D.lat,D.lon,N.lat,N.lon);
  const trip=tripCost(dist,gas,mpg,wage,spd,cont);
  const sav=t*ed*n;
  const net=sav-trip;
  const Vg=n*p.C;
  const thr=p.C*trip/(t*ed);
  const ok=Vg>=thr;
  const ann=net*5*50;
  const be=trip/(t*ed);

  document.getElementById('result').innerHTML=`
    <div class="verdict ${ok?'v-ok':'v-no'}">
      <div class="v-icon">${ok?'✅':'❌'}</div>
      <div>
        <div class="v-title">${ok?'This trip is economically viable':'Below the viability threshold'}</div>
        <div class="v-sub">${ok
          ?`Your $${Vg.toFixed(2)} donation clears the $${thr.toFixed(2)} threshold &nbsp;·&nbsp; ${dist.toFixed(2)} mi to ${N.name}`
          :`Donate ${Math.ceil(be-n)} more units per trip to break even &nbsp;·&nbsp; ${dist.toFixed(2)} mi to ${N.name}`
        }</div>
      </div>
      <div class="v-bracket">
        <div class="v-bracket-label">Your tax bracket</div>
        <div class="v-bracket-val">${(t*100).toFixed(0)}%</div>
      </div>
    </div>
    <div class="metrics">
      <div class="mc"><div class="ml">Tax savings / trip</div><div class="mv mv-ok">$${sav.toFixed(2)}</div></div>
      <div class="mc"><div class="ml">Net benefit / trip</div><div class="mv ${net>=0?'mv-ok':'mv-no'}">$${net.toFixed(2)}</div></div>
      <div class="mc"><div class="ml">Trip cost</div><div class="mv mv-neu">$${trip.toFixed(2)}</div></div>
      <div class="mc"><div class="ml">Donation value</div><div class="mv mv-neu">$${Vg.toFixed(2)}</div></div>
      <div class="mc"><div class="ml">Viability threshold</div><div class="mv mv-neu">$${thr.toFixed(2)}</div></div>
      <div class="mc"><div class="ml">Break-even units</div><div class="mv mv-neu">${be.toFixed(1)}</div></div>
    </div>
    <div class="ann-banner">
      <div class="ann-icon">📅</div>
      <div class="ann-text">Donating 5 nights a week, 50 weeks a year, your estimated annual net tax benefit is</div>
      <div class="ann-val ${ann>=0?'':'mv-no'}">${ann>=0?'$'+Math.round(ann).toLocaleString():'-$'+Math.round(Math.abs(ann)).toLocaleString()}</div>
    </div>`;
}

// Hero count-up
function countUp(){
  const el=document.getElementById('heroNum');
  const target=8750;
  let cur=0;
  const step=target/70;
  const t=setInterval(()=>{
    cur=Math.min(cur+step,target);
    el.textContent='$'+Math.round(cur).toLocaleString();
    if(cur>=target)clearInterval(t);
  },16);
}

// Boot
window.addEventListener('DOMContentLoaded',()=>{
  // Populate donor dropdown
  const ds=document.getElementById('dSel');
  DONORS.forEach(d=>{
    const o=document.createElement('option');
    o.value=d.id; o.textContent=d.name;
    ds.appendChild(o);
  });
  ds.addEventListener('change',()=>{
    D=DONORS.find(x=>x.id===ds.value);
    document.getElementById('dInfo').textContent=`${D.cat} · ${D.units} units/shift · $${PR[D.cat].C.toFixed(2)}/unit`;
    document.getElementById('distTag').innerHTML='';
    N=null;
    document.getElementById('nSel').value='';
    compute();
  });
  document.getElementById('dInfo').textContent=`${D.cat} · ${D.units} units/shift · $${PR[D.cat].C.toFixed(2)}/unit`;

  // Populate nonprofit dropdown
  const ns=document.getElementById('nSel');
  NPS.forEach(n=>{
    const o=document.createElement('option');
    o.value=n.id; o.textContent=n.name;
    ns.appendChild(o);
  });
  ns.addEventListener('change',()=>{
    N=NPS.find(x=>x.id===ns.value)||null;
    if(N&&D){
      const d=hav(D.lat,D.lon,N.lat,N.lon);
      document.getElementById('distTag').innerHTML=`<span class="dist-tag">${d.toFixed(2)} mi away</span>`;
    } else {
      document.getElementById('distTag').innerHTML='';
    }
    compute();
  });

  setTimeout(countUp,500);
});
</script>
</body>
</html>
